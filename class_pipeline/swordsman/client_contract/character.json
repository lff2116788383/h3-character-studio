{
 "schema_version": 1,
 "id": "swordsman",
 "version": "v2",
 "default_direction": "right",
 "size": [
  256,
  256
 ],
 "pivot": [
  128,
  240
 ],
 "pixel_size": 0.009,
 "directions": {
  "right": {
   "manifest": "right/animation.json",
   "idle_frame": 5,
   "generation": "class-pipeline-gpt"
  },
  "up": {
   "manifest": "up/animation.json",
   "idle_frame": 5,
   "generation": "class-pipeline-gpt"
  },
  "down": {
   "manifest": "down/animation.json",
   "idle_frame": 6,
   "generation": "class-pipeline-gpt"
  }
 },
 "stationary_behavior": "Hold a reviewed balanced frame from the current direction; no separately generated idle animation.",
 "motions": {
  "right": {
   "walk": "right/animation.json",
   "idle": "motions/idle/animation.json",
   "attack1": "motions/attack1/animation.json",
   "attack2": "motions/attack2/animation.json",
   "death": "motions/death/animation.json",
   "run": "motions/run/animation.json"
  },
  "up": {
   "walk": "up/animation.json",
   "idle": "motions/up/idle/animation.json",
   "attack1": "motions/up/attack1/animation.json",
   "attack2": "motions/up/attack2/animation.json",
   "death": "motions/up/death/animation.json",
   "run": "motions/up/run/animation.json"
  },
  "down": {
   "walk": "down/animation.json",
   "idle": "motions/down/idle/animation.json",
   "attack1": "motions/down/attack1/animation.json",
   "attack2": "motions/down/attack2/animation.json",
   "death": "motions/down/death/animation.json",
   "run": "motions/down/run/animation.json"
  }
 },
 "notes": "drop-in 兼容 crescent-traveler v1 契约; v2 起多方向(right/up/down) walk drop-in + per-direction motions/; idle/attack/death 走 motions/, 多 clip 播放支持见 docs/multi_clip_proposal.md。"
}